                                                    .weight(1f)
                                                    .graphicsLayer(rotationZ = rotation)
                                                    .pointerInput(book) {
                                                        detectTapGestures(
                                                            onTap = { onOpenBook(book) },
                                                            onLongPress = { bookToDelete = book }
