                                                    } else {
                                                        Box(
                                                            Modifier.fillMaxSize().background(Color(0xFFE0E0E0)),
                                                            contentAlignment = Alignment.Center
                                                        ) {
                                                            Text(
                                                                book.title,
                                                                textAlign = TextAlign.Center,
                                                                modifier = Modifier.padding(4.dp),
                                                                fontSize = 12.sp
                                                            )
                                                        }
                                                    }
                                                }
                                                // زر المفضلة (قلب) في الأعلى يميناً
                                                IconButton(
                                                    onClick = { onToggleFavorite(book.id) },
                                                    modifier = Modifier
                                                        .align(Alignment.TopEnd)
                                                        .size(28.dp)
                                                        .background(Color.Black.copy(alpha = 0.35f), RoundedCornerShape(50))
                                                ) {
                                                    Icon(
                                                        imageVector = if (book.favorite) Icons.Default.Favorite else Icons.Default.FavoriteBorder,
                                                        contentDescription = "مفضلة",
                                                        tint = if (book.favorite) Color(0xFFFF5252) else Color.White,
                                                        modifier = Modifier.size(18.dp)
                                                    )
                                                }
                                            }

                                            // اسم الكتاب + نسبة التقدم
                                            Spacer(Modifier.height(4.dp))
                                            Text(
                                                text = book.title,
                                                fontSize = 11.sp,
                                                maxLines = 2,
                                                overflow = TextOverflow.Ellipsis,
                                                color = Color.White,
                                                fontWeight = FontWeight.SemiBold,
                                                textAlign = TextAlign.Center,
                                                modifier = Modifier.fillMaxWidth()
                                            )
                                            val progress = if (book.total > 0)
                                                ((book.page.toFloat() / book.total.toFloat()) * 100f).coerceIn(0f, 100f)
                                            else 0f
                                            Text(
                                                text = "${progress.toInt()}%",
                                                fontSize = 10.sp,
                                                color = if (progress >= 100f) Color(0xFF7CFF7C) else Color.White.copy(alpha = 0.85f),
                                                textAlign = TextAlign.Center,
                                                modifier = Modifier.fillMaxWidth()
                                            )
                                            // شريط تقدم صغير
                                            Box(
                                                modifier = Modifier
                                                    .fillMaxWidth()
                                                    .padding(top = 2.dp)
                                                    .height(3.dp)
                                                    .clip(RoundedCornerShape(2.dp))
                                                    .background(Color.White.copy(alpha = 0.25f))
                                            ) {
                                                Box(
                                                    modifier = Modifier
                                                        .fillMaxWidth(progress / 100f)
                                                        .fillMaxHeight()
                                                        .background(if (progress >= 100f) Color(0xFF7CFF7C) else Color(0xFF9E86FF))
                                                )
                                            }
                                        }
                                    }
                                    repeat(columnsCount - rowBooks.size) {
                                        Spacer(modifier = Modifier.weight(1f))
                                    }
                                }
                                Box(
                                    modifier = Modifier
                                        .fillMaxWidth()
                                        .height(12.dp)
                                        .background(Brush.verticalGradient(colors = listOf(Color(0xFF6D4C41), Color(0xFF3E2723))))
                                )
                                Box(
                                    modifier = Modifier
                                        .fillMaxWidth()
                                        .height(20.dp)
                                        .background(Brush.verticalGradient(colors = listOf(Color.Black.copy(alpha = 0.4f), Color.Transparent)))
                                )
                                Spacer(modifier = Modifier.height(16.dp))
                            }
                        }
                    }
                }
            }
        }
    }

    if (bookToDelete != null) {
        AlertDialog(
            onDismissRequest = { bookToDelete = null },
            title = { Text("حذف الكتاب") },
            text = { Text("هل أنت متأكد من حذف '${bookToDelete?.title}'؟") },
            confirmButton = {
                TextButton(onClick = { onDelete(bookToDelete!!.id); bookToDelete = null }) {
                    Text("حذف", color = Color.Red)
                }
            },
            dismissButton = { TextButton(onClick = { bookToDelete = null }) { Text("إلغاء") } }
        )
    }
}

