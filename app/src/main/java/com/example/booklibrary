fun renderPdfPage(path: String, pageIndex: Int, targetWidth: Int = 1080): Bitmap? {
    val cacheKey = "$path#$pageIndex#$targetWidth"
    PdfBitmapCache.get(cacheKey)?.let { return it }

    var pfd: ParcelFileDescriptor? = null
    var renderer: PdfRenderer? = null
    var page: PdfRenderer.Page? = null
    return try {
        pfd = ParcelFileDescriptor.open(File(path), ParcelFileDescriptor.MODE_READ_ONLY)
        renderer = PdfRenderer(pfd)
        if (pageIndex !in 0 until renderer.pageCount) return null
        page = renderer.openPage(pageIndex)
        val width = targetWidth
        val height = (width * page.height.toFloat() / page.width).toInt().coerceAtLeast(1)
        val bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
        bitmap.eraseColor(android.graphics.Color.WHITE)
        page.render(bitmap, null, null, PdfRenderer.Page.RENDER_MODE_FOR_DISPLAY)
        PdfBitmapCache.put(cacheKey, bitmap)
        bitmap
    } catch (e: Exception) { null } finally {
        runCatching { page?.close() }
        runCatching { renderer?.close() }
        runCatching { pfd?.close() }
    }
}

fun performScanWithProgress(
    context: Context,
    scope: kotlinx.coroutines.CoroutineScope,
    books: List<Book>,
    onImport: (List<Book>) -> Unit,
    setScanning: (Boolean) -> Unit,
    updateProgress: (Float) -> Unit
) {
    setScanning(true)
    updateProgress(0f)
    scope.launch {
        val foundBooks = withContext(Dispatchers.IO) {
            scanDeviceForPdfsSimple(context, books, updateProgress)
        }
        onImport(foundBooks)
        setScanning(false)
        if (foundBooks.isNotEmpty()) {
            withContext(Dispatchers.Main) {
                Toast.makeText(context, "تم العثور على ${foundBooks.size} كتاب جديد", Toast.LENGTH_LONG).show()
            }
        } else {
            withContext(Dispatchers.Main) {
                Toast.makeText(context, "لم يتم العثور على ملفات جديدة", Toast.LENGTH_SHORT).show()
            }
        }
    }
}

fun scanDeviceForPdfsSimple(context: Context, existingBooks: List<Book>, updateProgress: (Float) -> Unit): List<Book> {
    val foundBooks = mutableListOf<Book>()
    val existingPaths = existingBooks.map { it.path }.toSet()

    val projection = arrayOf(
        MediaStore.Files.FileColumns.DATA,
        MediaStore.Files.FileColumns.DISPLAY_NAME
    )
    val selection = "${MediaStore.Files.FileColumns.MEDIA_TYPE} = ? OR ${MediaStore.Files.FileColumns.MEDIA_TYPE} = ?"
    val selectionArgs = arrayOf(
        MediaStore.Files.FileColumns.MEDIA_TYPE_NONE.toString(),
        MediaStore.Files.FileColumns.MEDIA_TYPE_DOCUMENT.toString()
    )

    context.contentResolver.query(MediaStore.Files.getContentUri("external"), projection, selection, selectionArgs, null)?.use { cursor ->
        val dataColumn = cursor.getColumnIndexOrThrow(MediaStore.Files.FileColumns.DATA)
        val nameColumn = cursor.getColumnIndexOrThrow(MediaStore.Files.FileColumns.DISPLAY_NAME)

        val totalCount = cursor.count
        var currentCount = 0

        while (cursor.moveToNext()) {
            currentCount++
            if (totalCount > 0) updateProgress(currentCount.toFloat() / totalCount)

            val path = cursor.getString(dataColumn)
            val name = cursor.getString(nameColumn)

            if (name != null && name.endsWith(".pdf", ignoreCase = true) && path != null && !existingPaths.contains(path)) {
                val total = getPageCount(path) ?: continue

                val coverFile = File(context.filesDir, "covers/${UUID.randomUUID()}_cover.jpg")
                coverFile.parentFile?.mkdirs()
                val coverBmp = renderPdfPage(path, 0, 400)
                coverBmp?.let { coverFile.outputStream().use { out -> it.compress(Bitmap.CompressFormat.JPEG, 80, out) } }

                foundBooks.add(
                    Book(
                        id = UUID.randomUUID().toString(),
                        path = path,
                        title = name.removeSuffix(".pdf"),
                        page = 0,
                        total = total,
                        addedAt = System.currentTimeMillis(),
                        coverPath = coverFile.absolutePath,
                        lastRead = 0L
                    )
                )
            }
        }
    }

    updateProgress(1f)
    return foundBooks
}

