fun importPdf(context: Context, uri: Uri): Book? {
    return try {
        val displayName = queryDisplayName(context, uri) ?: "book.pdf"
        val safeName = displayName.replace(Regex("[^\\p{L}\\p{N}._-]"), "_")
        val file = File(context.filesDir, "books/${System.currentTimeMillis()}_$safeName")
        file.parentFile?.mkdirs()
        context.contentResolver.openInputStream(uri)?.use { input ->
            file.outputStream().use { output -> input.copyTo(output) }
        } ?: return null
        val total = getPageCount(file.absolutePath) ?: return null
        val coverDir = File(context.filesDir, "covers")
        coverDir.mkdirs()
        val coverFile = File(coverDir, "${System.currentTimeMillis()}_cover.jpg")
        val coverBmp = renderPdfPage(file.absolutePath, 0, 400)
        coverBmp?.let { coverFile.outputStream().use { out -> it.compress(Bitmap.CompressFormat.JPEG, 80, out) } }

        Book(
            UUID.randomUUID().toString(),
            file.absolutePath,
            displayName.removeSuffix(".pdf"),
            0,
            total,
            System.currentTimeMillis(),
            coverFile.absolutePath,
            0L
        )
    } catch (e: Exception) { null }
}

fun queryDisplayName(context: Context, uri: Uri): String? {
    var name: String? = null
    context.contentResolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use { cursor ->
        if (cursor.moveToFirst()) {
            val index = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
            if (index >= 0) name = cursor.getString(index)
        }
    }
    return name
}

fun getPageCount(path: String): Int? {
    var pfd: ParcelFileDescriptor? = null
    var renderer: PdfRenderer? = null
    return try {
        pfd = ParcelFileDescriptor.open(File(path), ParcelFileDescriptor.MODE_READ_ONLY)
        renderer = PdfRenderer(pfd)
        renderer.pageCount
    } catch (e: Exception) {
        null
    } finally {
        runCatching { renderer?.close() }
        runCatching { pfd?.close() }
    }
}