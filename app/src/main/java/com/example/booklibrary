@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun ReaderScreen(
    book: Book,
    initialSearchQuery: String,
    initialSearchPositions: Map<Int, List<RectF>>,
    onProgress: (Int) -> Unit,
    onBack: (Int) -> Unit,
    onAddQuote: (Quote) -> Unit
) {
    val context = LocalContext.current
    val scope = rememberCoroutineScope()
    val activity = context as Activity

    val configuration = LocalConfiguration.current
    val isLandscape = configuration.orientation == Configuration.ORIENTATION_LANDSCAPE

    val pdfSession = remember(book.path) { PdfSession(book.path) }
    DisposableEffect(Unit) {
        onDispose { pdfSession.close() }
    }

    val pagerState = rememberPagerState(
        initialPage = book.page.coerceIn(0, (book.total - 1).coerceAtLeast(0)),
        pageCount = { book.total }
    )
    val lazyListState = rememberLazyListState(
        initialFirstVisibleItemIndex = book.page.coerceIn(0, (book.total - 1).coerceAtLeast(0))
    )

    var mode by remember { mutableStateOf(ReadingMode.NORMAL) }
    var showQuoteDialog by remember { mutableStateOf(false) }
    var showJumpDialog by remember { mutableStateOf(false) }
    var showSearchDialog by remember { mutableStateOf(false) }
    var showBrightnessDialog by remember { mutableStateOf(false) }

    var currentBrightness by remember {
        val initialBrightness = activity.window.attributes.screenBrightness
        mutableFloatStateOf(if (initialBrightness < 0f) 0.5f else initialBrightness)
    }

    var jumpPageText by remember { mutableStateOf("") }
    var searchQuery by remember { mutableStateOf(initialSearchQuery) }
    var searchResults by remember { mutableStateOf<List<Int>?>(null) }
    var isSearching by remember { mutableStateOf(false) }
    var searchProgress by remember { mutableFloatStateOf(0f) }
    var searchJob by remember { mutableStateOf<Job?>(null) }
    // خريطة المواضع المميزة: صفحة -> rects
    var highlightPositions by remember { mutableStateOf<Map<Int, List<RectF>>>(initialSearchPositions) }
    // نص البحث الذي تُلوّن له الكلمات
    var highlightQuery by remember { mutableStateOf(initialSearchQuery) }

    var quoteText by remember { mutableStateOf("") }
    var quoteImagePath by remember { mutableStateOf<String?>(null) }
    var isUiVisible by rememberSaveable { mutableStateOf(true) }
    var resetZoomTrigger by remember { mutableStateOf(0) }

    // إذا وصلنا من بحث سابق، املأ النتائج
    LaunchedEffect(Unit) {
        if (initialSearchPositions.isNotEmpty()) {
            searchResults = initialSearchPositions.keys.sorted()
        }
    }

    LaunchedEffect(pagerState.currentPage) {
        if (!isLandscape) onProgress(pagerState.currentPage)
    }
    LaunchedEffect(lazyListState.firstVisibleItemIndex) {
        if (isLandscape) onProgress(lazyListState.firstVisibleItemIndex)
    }

    var isSyncingLayout by remember { mutableStateOf(false) }
    LaunchedEffect(isLandscape) {
        if (!isSyncingLayout) {
            isSyncingLayout = true
            try {
                if (isLandscape) {
                    lazyListState.scrollToItem(pagerState.currentPage)
                } else {
                    pagerState.scrollToPage(lazyListState.firstVisibleItemIndex)
                }
            } finally {
                isSyncingLayout = false
            }
        }
    }

    Scaffold(
        topBar = {
            AnimatedVisibility(visible = isUiVisible) {
                Surface(shadowElevation = 4.dp) {
                    Row(
                        modifier = Modifier.fillMaxWidth().height(50.dp).padding(horizontal = 4.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        IconButton(onClick = {
                            onBack(if (isLandscape) lazyListState.firstVisibleItemIndex else pagerState.currentPage)
                        }) { Icon(Icons.Default.ArrowBack, "رجوع") }
                        Text(
                            book.title,
                            maxLines = 1,
                            modifier = Modifier.weight(1f),
                            fontSize = 16.sp,
                            fontWeight = FontWeight.Bold
                        )
                        IconButton(onClick = { showSearchDialog = true }) { Icon(Icons.Default.Search, "بحث") }
                        IconButton(onClick = {
                            scope.launch {
                                val currentPage = if (isLandscape) lazyListState.firstVisibleItemIndex else pagerState.currentPage
                                val bmp = withContext(Dispatchers.IO) { pdfSession.render(currentPage, 1080) }
                                if (bmp != null) {
                                    val file = File(context.filesDir, "quotes/${System.currentTimeMillis()}.png")
                                    file.parentFile?.mkdirs()
                                    file.outputStream().use { bmp.compress(Bitmap.CompressFormat.PNG, 100, it) }
                                    quoteImagePath = file.absolutePath
                                    quoteText = ""
                                    showQuoteDialog = true
                                }
                            }
                        }) { Icon(Icons.Default.FormatQuote, "اقتباس") }
                        // زر مسح التمييز
                        if (highlightPositions.isNotEmpty()) {
                            IconButton(onClick = {
                                highlightPositions = emptyMap()
                                highlightQuery = ""
                                searchResults = null
                            }) { Icon(Icons.Default.Clear, "مسح التمييز") }
                        }
                    }
                }
            }
        },
        bottomBar = {
            AnimatedVisibility(visible = isUiVisible) {
                BottomAppBar(
                    modifier = Modifier.height(56.dp),
                    containerColor = Color(0xFF1E1E24),
                    contentColor = Color(0xFF9E86FF)
                ) {
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.SpaceEvenly,
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        IconButton(onClick = {
                            activity.requestedOrientation =
                                if (activity.requestedOrientation == ActivityInfo.SCREEN_ORIENTATION_LANDSCAPE)
                                    ActivityInfo.SCREEN_ORIENTATION_PORTRAIT
                                else
                                    ActivityInfo.SCREEN_ORIENTATION_LANDSCAPE
                        }) { Icon(Icons.Default.ScreenRotation, "تدوير") }

                        IconButton(onClick = { showBrightnessDialog = true }) {
                            Icon(Icons.Default.LightMode, "السطوع")
                        }

                        IconButton(onClick = {
                            mode = when (mode) {
                                ReadingMode.NORMAL -> ReadingMode.SEPIA
                                ReadingMode.SEPIA -> ReadingMode.NIGHT
                                ReadingMode.NIGHT -> ReadingMode.NORMAL
                            }
                        }) { Icon(Icons.Default.DarkMode, "تغيير الألوان") }

                        IconButton(onClick = { showJumpDialog = true }) {
                            Icon(Icons.Default.TouchApp, "انتقال")
                        }

                        IconButton(onClick = {
                            resetZoomTrigger++
                            isUiVisible = false
                        }) { Icon(Icons.Default.KeyboardArrowDown, "توسيط") }
                    }
                }
            }
        }
    ) { padding ->
        Box(modifier = Modifier.padding(padding).fillMaxSize()) {
            if (isLandscape) {
                LazyColumn(
                    state = lazyListState,
                    modifier = Modifier.fillMaxSize().background(mode.background)
                ) {
                    items(book.total) { pageIndex ->
                        LandscapePdfPage(
                            session = pdfSession,
                            pageIndex = pageIndex,
                            mode = mode,
                            highlightPositions = highlightPositions[pageIndex],
                            modifier = Modifier.fillMaxWidth().padding(vertical = 4.dp),
                            onTap = { isUiVisible = !isUiVisible }
                        )
                    }
                }
            } else {
                HorizontalPager(state = pagerState, modifier = Modifier.fillMaxSize()) { page ->
                    PortraitPdfPage(
                        session = pdfSession,
                        pageIndex = page,
                        mode = mode,
                        highlightPositions = highlightPositions[page],
                        modifier = Modifier.fillMaxSize(),
                        resetZoomTrigger = resetZoomTrigger,
                        onTap = { isUiVisible = !isUiVisible }
                    )
                }
            }

            if (isUiVisible) {
                val currentPage = if (isLandscape) lazyListState.firstVisibleItemIndex else pagerState.currentPage
                Text(
                    "${currentPage + 1} / ${book.total}",
                    modifier = Modifier
                        .align(Alignment.BottomCenter)
                        .padding(16.dp)
                        .background(Color.Black.copy(alpha = 0.5f), MaterialTheme.shapes.small)
                        .padding(8.dp),
                    color = Color.White
                )
            }
        }
    }

    if (showBrightnessDialog) {
        AlertDialog(
            onDismissRequest = { showBrightnessDialog = false },
            title = { Text("سطوع الشاشة") },
            text = {
                Column {
                    Slider(
                        value = currentBrightness,
                        onValueChange = {
                            currentBrightness = it
                            activity.window.attributes = activity.window.attributes.apply { screenBrightness = it }
                        },
                        valueRange = 0.1f..1.0f
                    )
                }
            },
            confirmButton = {
                TextButton(onClick = { showBrightnessDialog = false }) { Text("موافق") }
            }
        )
    }

    if (showQuoteDialog) {
        AlertDialog(
            onDismissRequest = {
                showQuoteDialog = false
                quoteImagePath = null
            },
            title = { Text("حفظ اقتباس") },
            text = {
                OutlinedTextField(
                    value = quoteText,
                    onValueChange = { quoteText = it },
                    label = { Text("نص (اختياري)") },
                    minLines = 3
                )
            },
            confirmButton = {
                TextButton(onClick = {
                    val currentPage = if (isLandscape) lazyListState.firstVisibleItemIndex else pagerState.currentPage
                    onAddQuote(
                        Quote(
                            UUID.randomUUID().toString(),
                            book.title,
                            quoteText.ifBlank { "صفحة ${currentPage + 1}" },
                            quoteImagePath,
                            currentPage,
                            System.currentTimeMillis()
                        )
                    )
                    showQuoteDialog = false
                    quoteImagePath = null
                    quoteText = ""
                }) { Text("حفظ") }
            },
            dismissButton = {
                TextButton(onClick = { showQuoteDialog = false; quoteImagePath = null }) { Text("إلغاء") }
            }
        )
    }

    if (showJumpDialog) {
        AlertDialog(
            onDismissRequest = { showJumpDialog = false; jumpPageText = "" },
            title = { Text("الانتقال إلى صفحة") },
            text = {
                OutlinedTextField(
                    value = jumpPageText,
                    onValueChange = { jumpPageText = it },
                    label = { Text("رقم الصفحة (1 - ${book.total})") },
                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
                    singleLine = true
                )
            },
            confirmButton = {
                TextButton(onClick = {
                    val page = jumpPageText.toIntOrNull()?.minus(1)
                    if (page != null && page in 0 until book.total) {
                        scope.launch {
                            if (isLandscape) lazyListState.scrollToItem(page) else pagerState.scrollToPage(page)
                        }
                    }
                    showJumpDialog = false
                    jumpPageText = ""
                }) { Text("انتقال") }
            },
            dismissButton = {
                TextButton(onClick = { showJumpDialog = false; jumpPageText = "" }) { Text("إلغاء") }
            }
        )
    }

    if (showSearchDialog) {
        AlertDialog(
            onDismissRequest = {
                searchJob?.cancel()
                isSearching = false
                showSearchDialog = false
            },
            title = { Text("البحث في النص") },
            text = {
                Column {
                    OutlinedTextField(
                        value = searchQuery,
                        onValueChange = { searchQuery = it },
                        label = { Text("أدخل الكلمة أو النص") },
                        singleLine = true,
                        modifier = Modifier.fillMaxWidth()
                    )
                    Spacer(modifier = Modifier.height(12.dp))

                    if (isSearching) {
                        LinearProgressIndicator(
                            progress = { searchProgress.coerceIn(0f, 1f) },
                            modifier = Modifier.fillMaxWidth()
                        )
                        Spacer(Modifier.height(4.dp))
                        Text("جاري البحث... ${(searchProgress * 100).toInt()}%", fontSize = 12.sp)
                    } else if (searchResults != null) {
                        if (searchResults!!.isEmpty()) {
                            Text("لم يتم العثور على نتائج.", color = Color.Red)
                        } else {
                            Text(
                                "تم العثور عليها في ${searchResults!!.size} صفحة (مميزة بالأصفر):",
                                fontSize = 13.sp,
                                fontWeight = FontWeight.SemiBold
                            )
                            Spacer(Modifier.height(4.dp))
                            LazyColumn(modifier = Modifier.heightIn(max = 220.dp)) {
                                items(searchResults!!) { page ->
                                    Text(
                                        text = "صفحة ${page + 1}",
                                        modifier = Modifier
                                            .fillMaxWidth()
                                            .clickable {
                                                scope.launch {
                                                    if (isLandscape) lazyListState.scrollToItem(page)
                                                    else pagerState.scrollToPage(page)
                                                }
                                                showSearchDialog = false
                                            }
                                            .padding(10.dp),
                                        color = MaterialTheme.colorScheme.primary
                                    )
                                }
                            }
                        }
                    }
                }
            },
            confirmButton = {
                TextButton(
                    onClick = {
                        if (searchQuery.isNotBlank()) {
                            isSearching = true
                            searchResults = null
                            searchProgress = 0f
                            val q = searchQuery
                            searchJob = scope.launch {
                                val (pages, positions) = withContext(Dispatchers.IO) {
                                    searchPdfWithPositions(book.path, q) { p ->
                                        searchProgress = p
                                    }
                                }
                                searchResults = pages
                                highlightPositions = positions
                                highlightQuery = q
                                isSearching = false
                            }
                        }
                    },
                    enabled = searchQuery.isNotBlank() && !isSearching
                ) { Text("بحث") }
            },
            dismissButton = {
                TextButton(onClick = {
                    searchJob?.cancel()
                    isSearching = false
                    showSearchDialog = false
                }) { Text("إغلاق") }
            }
        )
    }
}

