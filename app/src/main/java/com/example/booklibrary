                                text = "جاري الفحص... ${(scanProgress.coerceIn(0f, 1f) * 100).toInt()}%",
                                color = Color.White,
                                fontSize = 10.sp,
                                modifier = Modifier.padding(top = 2.dp)
                            )
                        }
                    }
                }
            }
        ) { padding ->
            Box(
                modifier = Modifier.padding(padding).fillMaxSize().background(woodBackground)
            ) {
                if (displayedBooks.isEmpty()) {
                    Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                        Text(
                            when {
                                librarySearchQuery.isNotBlank() -> "لا نتائج لـ \"$librarySearchQuery\""
