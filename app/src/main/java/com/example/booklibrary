@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun LibraryScreen(
    books: List<Book>,
    dark: Boolean,
    onToggleDark: () -> Unit,
    onOpenQuotes: () -> Unit,
    onOpenBook: (Book) -> Unit,
    onImport: (List<Book>) -> Unit,
    onDelete: (String) -> Unit,
    onToggleFavorite: (String) -> Unit
) {
    val context = LocalContext.current
    val scope = rememberCoroutineScope()
    var bookToDelete by remember { mutableStateOf<Book?>(null) }
    var isScanning by remember { mutableStateOf(false) }
    var scanProgress by remember { mutableFloatStateOf(0f) }
    var showOnlyRecent by remember { mutableStateOf(false) }
    var showOnlyFavorites by remember { mutableStateOf(false) }
    var columnsCount by remember { mutableStateOf(3) }
    val drawerState = rememberDrawerState(initialValue = DrawerValue.Closed)

    // حالة البحث في المكتبة
    var librarySearchOpen by remember { mutableStateOf(false) }
    var librarySearchQuery by remember { mutableStateOf("") }

    LaunchedEffect(Unit) {
        if (books.isEmpty()) {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
                if (!Environment.isExternalStorageManager()) {
                    try {
                        val intent = Intent(Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION)
                        intent.addCategory("android.intent.category.DEFAULT")
                        intent.data = Uri.parse("package:${context.packageName}")
                        context.startActivity(intent)
                    } catch (e: Exception) {
                        val intent = Intent(Settings.ACTION_MANAGE_ALL_FILES_ACCESS_PERMISSION)
                        context.startActivity(intent)
                    }
                } else {
                    performScanWithProgress(context, scope, books, onImport, { isScanning = it }, { scanProgress = it })
                }
            } else {
                if (ContextCompat.checkSelfPermission(context, Manifest.permission.READ_EXTERNAL_STORAGE) == PackageManager.PERMISSION_GRANTED) {
                    performScanWithProgress(context, scope, books, onImport, { isScanning = it }, { scanProgress = it })
                }
            }
        }
    }

    val launcher = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
        if (uri != null) {
            scope.launch {
                val book = withContext(Dispatchers.IO) { importPdf(context, uri) }
                if (book != null) onImport(listOf(book))
            }
        }
    }

    // ترتيب + فلترة
    val baseBooks = when {
        showOnlyRecent -> books.filter { it.lastRead > 0 }.sortedByDescending { it.lastRead }
        showOnlyFavorites -> books.filter { it.favorite }.sortedBy { it.title }
        else -> books.sortedBy { it.title }
    }
    val displayedBooks = if (librarySearchQuery.isBlank()) baseBooks
    else baseBooks.filter { it.title.contains(librarySearchQuery, ignoreCase = true) }

    val woodBackground = Brush.verticalGradient(
        colors = listOf(Color(0xFFB58B6A), Color(0xFF8B5A2B), Color(0xFF5C3A21))
    )

    ModalNavigationDrawer(
        drawerState = drawerState,
        drawerContent = {
            ModalDrawerSheet {
                Text("Book Library", modifier = Modifier.padding(16.dp), fontWeight = FontWeight.Bold, fontSize = 20.sp)
                Divider()
                NavigationDrawerItem(
                    label = { Text("كل الكتب") },
                    selected = !showOnlyRecent && !showOnlyFavorites,
                    onClick = {
                        showOnlyRecent = false; showOnlyFavorites = false
                        scope.launch { drawerState.close() }
                    },
                    icon = { Icon(Icons.Default.List, null) }
                )
                NavigationDrawerItem(
                    label = { Text("القراءة الحالية") },
                    selected = showOnlyRecent,
                    onClick = {
                        showOnlyRecent = true; showOnlyFavorites = false
                        scope.launch { drawerState.close() }
                    },
                    icon = { Icon(Icons.Default.History, null) }
                )
                NavigationDrawerItem(
                    label = { Text("المفضلة") },
                    selected = showOnlyFavorites,
                    onClick = {
                        showOnlyFavorites = true; showOnlyRecent = false
                        scope.launch { drawerState.close() }
                    },
                    icon = { Icon(Icons.Default.Favorite, null) }
                )
                NavigationDrawerItem(
                    label = { Text("مخزن الاقتباسات") },
                    selected = false,
                    onClick = { onOpenQuotes(); scope.launch { drawerState.close() } },
                    icon = { Icon(Icons.Default.FormatQuote, null) }
                )
                Divider()
                Text("حجم الشبكة", modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp), fontSize = 12.sp, color = Color.Gray)
                Row(modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    listOf(2, 3, 4, 5).forEach { cols ->
                        FilterChip(
                            selected = columnsCount == cols,
                            onClick = { columnsCount = cols },
                            label = { Text("$cols × $cols") }
                        )
                    }
                }
            }
        }
    ) {
        Scaffold(
            topBar = {
                Column {
                    Surface(shadowElevation = 4.dp, color = Color(0xFF2D1B11)) {
                        if (librarySearchOpen) {
                            // شريط البحث
                            Row(
                                modifier = Modifier.fillMaxWidth().height(50.dp).padding(horizontal = 4.dp),
                                verticalAlignment = Alignment.CenterVertically
                            ) {
                                IconButton(onClick = {
                                    librarySearchOpen = false; librarySearchQuery = ""
                                }) {
                                    Icon(Icons.Default.ArrowBack, "إغلاق", tint = Color.White)
                                }
                                TextField(
                                    value = librarySearchQuery,
                                    onValueChange = { librarySearchQuery = it },
                                    placeholder = { Text("ابحث عن كتاب...", color = Color.White.copy(alpha = 0.6f)) },
                                    singleLine = true,
                                    colors = TextFieldDefaults.colors(
                                        focusedContainerColor = Color.Transparent,
                                        unfocusedContainerColor = Color.Transparent,
                                        focusedTextColor = Color.White,
                                        unfocusedTextColor = Color.White,
                                        cursorColor = Color.White,
                                        focusedIndicatorColor = Color.Transparent,
                                        unfocusedIndicatorColor = Color.Transparent
                                    ),
                                    modifier = Modifier.weight(1f)
                                )
                            }
                        } else {
                            Row(
                                modifier = Modifier.fillMaxWidth().height(50.dp).padding(horizontal = 8.dp),
                                verticalAlignment = Alignment.CenterVertically
                            ) {
                                IconButton(onClick = { scope.launch { drawerState.open() } }) {
                                    Icon(Icons.Default.Menu, "القائمة", tint = Color.White)
                                }
                                Text(
                                    text = when {
                                        showOnlyRecent -> "القراءة الحالية"
                                        showOnlyFavorites -> "المفضلة"
                                        else -> "Book Library"
                                    },
                                    modifier = Modifier.weight(1f),
                                    fontWeight = FontWeight.Bold,
                                    fontSize = 18.sp,
                                    color = Color.White
                                )
                                // بحث في المكتبة
                                IconButton(onClick = { librarySearchOpen = true }) {
                                    Icon(Icons.Default.Search, "بحث", tint = Color.White)
                                }
                                IconButton(onClick = onToggleDark) {
                                    Icon(if (dark) Icons.Default.LightMode else Icons.Default.DarkMode, "وضع", tint = Color.White)
                                }
                                IconButton(onClick = { launcher.launch(arrayOf("application/pdf")) }) {
                                    Icon(Icons.Default.Add, "إضافة ملف", tint = Color.White)
                                }
                                IconButton(onClick = {
                                    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
                                        if (Environment.isExternalStorageManager()) {
                                            performScanWithProgress(context, scope, books, onImport, { isScanning = it }, { scanProgress = it })
                                        } else {
                                            try {
                                                val intent = Intent(Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION)
                                                intent.addCategory("android.intent.category.DEFAULT")
                                                intent.data = Uri.parse("package:${context.packageName}")
                                                context.startActivity(intent)
                                            } catch (e: Exception) {
                                                val intent = Intent(Settings.ACTION_MANAGE_ALL_FILES_ACCESS_PERMISSION)
                                                context.startActivity(intent)
                                            }
                                        }
                                    } else {
                                        performScanWithProgress(context, scope, books, onImport, { isScanning = it }, { scanProgress = it })
