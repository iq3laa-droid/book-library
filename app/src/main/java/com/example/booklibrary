data class Book(
    val id: String,
    val path: String,
    val title: String,
    val page: Int,
    val total: Int,
    val addedAt: Long,
    val coverPath: String? = null,
    val lastRead: Long = 0L,
    val favorite: Boolean = false
)

data class Quote(
    val id: String,
    val bookTitle: String,
    val text: String,
    val imagePath: String?,
    val page: Int,
    val createdAt: Long
)

class LibraryStore(context: Context) {
    private val prefs = context.getSharedPreferences("book_library", Context.MODE_PRIVATE)

    fun loadBooks(): List<Book> {
        val arr = JSONArray(prefs.getString("books", "[]") ?: "[]")
        return (0 until arr.length()).mapNotNull { i ->
            runCatching {
                val o = arr.getJSONObject(i)
                Book(
                    o.getString("id"), o.getString("path"), o.getString("title"),
                    o.optInt("page", 0), o.optInt("total", 1), o.optLong("addedAt", 0L),
                    o.optString("coverPath", "").ifBlank { null },
                    o.optLong("lastRead", 0L),
                    o.optBoolean("favorite", false)
                )
            }.getOrNull()
        }
    }

    fun saveBooks(books: List<Book>) {
        val arr = JSONArray()
        books.forEach { b ->
            arr.put(JSONObject().apply {
                put("id", b.id); put("path", b.path); put("title", b.title)
                put("page", b.page); put("total", b.total); put("addedAt", b.addedAt)
                put("coverPath", b.coverPath ?: ""); put("lastRead", b.lastRead)
                put("favorite", b.favorite)
            })
        }
        prefs.edit().putString("books", arr.toString()).apply()
    }

    fun loadQuotes(): List<Quote> {
        val arr = JSONArray(prefs.getString("quotes", "[]") ?: "[]")
        return (0 until arr.length()).mapNotNull { i ->
            runCatching {
                val o = arr.getJSONObject(i)
                Quote(
                    o.getString("id"), o.getString("bookTitle"), o.getString("text"),
                    o.optString("imagePath", "").ifBlank { null },
                    o.optInt("page", 0), o.optLong("createdAt", 0L)
                )
            }.getOrNull()
        }
    }

    fun saveQuotes(quotes: List<Quote>) {
        val arr = JSONArray()
        quotes.forEach { q ->
            arr.put(JSONObject().apply {
                put("id", q.id); put("bookTitle", q.bookTitle); put("text", q.text)
                put("imagePath", q.imagePath ?: ""); put("page", q.page); put("createdAt", q.createdAt)
            })
        }
        prefs.edit().putString("quotes", arr.toString()).apply()
    }
}

