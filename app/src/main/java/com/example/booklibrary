// ===================== PDF Cache + Session =====================

object PdfBitmapCache {
    private val cache = object : LruCache<String, Bitmap>(48 * 1024 * 1024) {
        override fun sizeOf(key: String, value: Bitmap) = value.byteCount
    }
    fun get(key: String): Bitmap? = cache.get(key)
    fun put(key: String, bmp: Bitmap) { cache.put(key, bmp) }
    fun clear() = cache.evictAll()
}

class PdfSession(private val path: String) {
    private var pfd: ParcelFileDescriptor? = null
    private var renderer: PdfRenderer? = null

    init {
        try {
            pfd = ParcelFileDescriptor.open(File(path), ParcelFileDescriptor.MODE_READ_ONLY)
            renderer = PdfRenderer(pfd!!)
        } catch (e: Exception) {
            e.printStackTrace()
        }
    }

    fun pageCount(): Int = renderer?.pageCount ?: 0

    @Synchronized
    fun render(pageIndex: Int, targetWidth: Int): Bitmap? {
        val cacheKey = "$path#$pageIndex#$targetWidth"
        PdfBitmapCache.get(cacheKey)?.let { return it }

        val r = renderer ?: return null
        if (pageIndex !in 0 until r.pageCount) return null
        return try {
            r.openPage(pageIndex).use { page ->
                val height = (targetWidth * page.height.toFloat() / page.width).toInt().coerceAtLeast(1)
                val bitmap = Bitmap.createBitmap(targetWidth, height, Bitmap.Config.ARGB_8888)
                bitmap.eraseColor(android.graphics.Color.WHITE)
                page.render(bitmap, null, null, PdfRenderer.Page.RENDER_MODE_FOR_DISPLAY)
                PdfBitmapCache.put(cacheKey, bitmap)
                bitmap
            }
        } catch (e: Exception) {
            e.printStackTrace()
            null
        }
    }

    fun close() {
        runCatching { renderer?.close() }
        runCatching { pfd?.close() }
        renderer = null
        pfd = null
    }
}

// ===================== بحث في PDF مع مواضع الكلمات =====================

data class WordHit(val page: Int, val rect: RectF)

/**
 * يبحث عن الكلمة في كل صفحات الـ PDF ويعيد:
 * - قائمة الصفحات التي تحتويها
 * - إحداثيات الكلمة داخل كل صفحة (كنسبة 0..1) لتلوينها لاحقاً
 */
suspend fun searchPdfWithPositions(
    filePath: String,
    query: String,
    onProgress: (Float) -> Unit = {}
): Pair<List<Int>, Map<Int, List<RectF>>> {
    val pages = mutableListOf<Int>()
    val positions = mutableMapOf<Int, MutableList<RectF>>()
    var document: PDDocument? = null
    try {
        val file = File(filePath)
        document = PDDocument.load(
            file,
            com.tom_roush.pdfbox.io.MemoryUsageSetting.setupTempFileOnly()
        )
        val total = document.numberOfPages
        val q = query.lowercase()

        val stripper = object : PDFTextStripper() {
            override fun writeString(text: String?, textPositions: MutableList<TextPosition>?) {
                if (text == null || textPositions.isNullOrEmpty()) return
                val pageIdx = startPage - 1
                // نعالج كل موضع حرف ونكوّن كلمات
                var i = 0
                while (i < textPositions.size) {
                    // اجمع أحرفاً متتالية بدون مسافة لتكوين كلمة
                    val wordChars = mutableListOf<TextPosition>()
                    while (i < textPositions.size && !textPositions[i].unicode.trim().isEmpty()) {
                        wordChars.add(textPositions[i])
                        i++
                    }
                    if (wordChars.isNotEmpty()) {
                        val word = wordChars.joinToString("") { it.unicode }
                        if (word.lowercase().contains(q)) {
                            if (!pages.contains(pageIdx)) pages.add(pageIdx)
                            // احسب rect الكلمة كله
                            val minX = wordChars.minOf { it.xDirAdj }
                            val maxX = wordChars.maxOf { it.xDirAdj + it.widthDirAdj }
                            val minY = wordChars.minOf { it.yDirAdj - it.heightDir }
                            val maxY = wordChars.maxOf { it.yDirAdj }
                            // حوّل للإحداثيات النسبية باستخدام أبعاد الصفحة
                            val page1 = document?.getPage(pageIdx)
                            if (page1 != null) {
                                val pw = page1.mediaBox.width
                                val ph = page1.mediaBox.height
                                val rect = RectF(minX / pw, minY / ph, maxX / pw, maxY / ph)
                                positions.getOrPut(pageIdx) { mutableListOf() }.add(rect)
                            }
                        }
                    }
                    i++
                }
            }
        }
        stripper.sortByPosition = true

        for (i in 0 until total) {
            kotlinx.coroutines.currentCoroutineContext().ensureActive()
            stripper.startPage = i + 1
            stripper.endPage = i + 1
            stripper.getText(document)
            onProgress((i + 1).toFloat() / total)
        }
        document.close()
    } catch (e: kotlinx.coroutines.CancellationException) {
        runCatching { document?.close() }
        throw e
    } catch (e: Exception) {
        e.printStackTrace()
        runCatching { document?.close() }
    }
    return pages to positions
}

/**
 * يرسم مستطيلات صفراء فوق صورة الصفحة عند مواضع الكلمة.
 * positions نسبية (0..1) نسبة لأبعاد الصفحة.
 */
fun drawHighlightsOnBitmap(
    base: Bitmap,
    positions: List<RectF>
): Bitmap {
    if (positions.isEmpty()) return base
    val mutable = base.copy(Bitmap.Config.ARGB_8888, true)
    val canvas = Canvas(mutable)
    val paint = Paint().apply {
        color = AndroidColor.argb(140, 255, 235, 59) // أصفر شفاف
        style = Paint.Style.FILL
    }
    val w = mutable.width.toFloat()
    val h = mutable.height.toFloat()
    for (r in positions) {
        // ملاحظة: إحداثيات PDF تكون من الأعلى حسب yDirAdj لـ PDFBox
        val rect = RectF(r.left * w, r.top * h, r.right * w, r.bottom * h)
        canvas.drawRect(rect, paint)
    }
    return mutable
}

// ===================== شاشة التطبيق الرئيسية =====================

@Composable
fun BookLibraryApp() {
    val context = LocalContext.current
    val store = remember { LibraryStore(context) }
    var books by remember { mutableStateOf(store.loadBooks()) }
    var quotes by remember { mutableStateOf(store.loadQuotes()) }
    var readingBook by remember { mutableStateOf<Book?>(null) }
    var showQuotes by remember { mutableStateOf(false) }
    var dark by remember { mutableStateOf(false) }
    // البحث الممرر لشاشة القارئ (نص + مواضع)
    var readerSearchQuery by remember { mutableStateOf("") }
    var readerSearchPositions by remember { mutableStateOf<Map<Int, List<RectF>>>(emptyMap()) }

    val lifecycleOwner = androidx.lifecycle.compose.LocalLifecycleOwner.current
    DisposableEffect(lifecycleOwner) {
        val observer = androidx.lifecycle.LifecycleEventObserver { _, event ->
            if (event == androidx.lifecycle.Lifecycle.Event.ON_PAUSE || event == androidx.lifecycle.Lifecycle.Event.ON_STOP) {
                if (currentReadingBookId != null) {
                    val updatedBooks = books.map {
                        if (it.id == currentReadingBookId)
                            it.copy(page = lastKnownPage, lastRead = System.currentTimeMillis())
                        else it
                    }
                    store.saveBooks(updatedBooks)
                    books = updatedBooks
                }
            }
        }
        lifecycleOwner.lifecycle.addObserver(observer)
        onDispose { lifecycleOwner.lifecycle.removeObserver(observer) }
    }

    BackHandler(enabled = readingBook != null || showQuotes) {
        if (readingBook != null) {
            (context as Activity).requestedOrientation = ActivityInfo.SCREEN_ORIENTATION_PORTRAIT
            if (currentReadingBookId != null) {
                val updatedBooks = books.map {
                    if (it.id == currentReadingBookId)
                        it.copy(page = lastKnownPage, lastRead = System.currentTimeMillis())
                    else it
                }
                store.saveBooks(updatedBooks)
                books = updatedBooks
            }
            currentReadingBookId = null
            readingBook = null
            readerSearchQuery = ""
            readerSearchPositions = emptyMap()
        } else if (showQuotes) {
            showQuotes = false
        }
    }

    MaterialTheme(colorScheme = if (dark) darkColorScheme() else lightColorScheme()) {
        Surface(modifier = Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
            when {
                readingBook != null -> {
                    currentReadingBookId = readingBook!!.id
                    lastKnownPage = readingBook!!.page
                    ReaderScreen(
                        book = readingBook!!,
                        initialSearchQuery = readerSearchQuery,
                        initialSearchPositions = readerSearchPositions,
                        onProgress = { page ->
                            lastKnownPage = page
                            readingBook = readingBook?.copy(page = page, lastRead = System.currentTimeMillis())
                        },
                        onBack = { page ->
                            (context as Activity).requestedOrientation = ActivityInfo.SCREEN_ORIENTATION_PORTRAIT
                            if (currentReadingBookId != null) {
                                val updatedBooks = books.map {
                                    if (it.id == currentReadingBookId)
                                        it.copy(page = page, lastRead = System.currentTimeMillis())
                                    else it
                                }
                                store.saveBooks(updatedBooks)
                                books = updatedBooks
                            }
                            currentReadingBookId = null
                            readingBook = null
                            readerSearchQuery = ""
                            readerSearchPositions = emptyMap()
                        },
                        onAddQuote = { quote ->
                            quotes = quotes + quote
                            store.saveQuotes(quotes)
                        }
                    )
                }

                showQuotes -> QuotesScreen(
                    quotes = quotes,
                    onDelete = { id ->
                        quotes = quotes.filter { it.id != id }
                        store.saveQuotes(quotes)
                    },
                    onBack = { showQuotes = false }
                )

                else -> LibraryScreen(
                    books = books,
                    dark = dark,
                    onToggleDark = { dark = !dark },
                    onOpenQuotes = { showQuotes = true },
                    onOpenBook = { readingBook = it },
                    onImport = { newBooks ->
                        books = books + newBooks
                        store.saveBooks(books)
                    },
                    onDelete = { id ->
                        books.find { it.id == id }?.coverPath?.let { runCatching { File(it).delete() } }
                        books = books.filter { it.id != id }
                        store.saveBooks(books)
                    },
                    onToggleFavorite = { id ->
                        books = books.map { if (it.id == id) it.copy(favorite = !it.favorite) else it }
                        store.saveBooks(books)
                    }
                )
            }
        }
    }
}

