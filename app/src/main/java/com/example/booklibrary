@Composable
fun PortraitPdfPage(
    session: PdfSession?,
    pageIndex: Int,
    mode: ReadingMode,
    highlightPositions: List<RectF>?,
    modifier: Modifier = Modifier,
    resetZoomTrigger: Int,
    onTap: () -> Unit
) {
    var scale by remember { mutableFloatStateOf(1f) }
    var offset by remember { mutableStateOf(Offset.Zero) }

    val density = LocalDensity.current
    val config = LocalConfiguration.current
    val targetWidth = with(density) { config.screenWidthDp.dp.toPx() }.toInt().coerceIn(720, 1400)

    val bitmap by produceState<Bitmap?>(null, pageIndex, targetWidth, highlightPositions) {
        value = withContext(Dispatchers.IO) {
            val raw = session?.render(pageIndex, targetWidth)
            if (raw != null && !highlightPositions.isNullOrEmpty()) {
                drawHighlightsOnBitmap(raw, highlightPositions)
            } else raw
        }
    }

    LaunchedEffect(resetZoomTrigger, pageIndex) {
        scale = 1f
        offset = Offset.Zero
    }

    Box(
        modifier = modifier
            .background(mode.background)
            .pointerInput(Unit) {
                awaitEachGesture {
                    awaitFirstDown(requireUnconsumed = false)
                    var isTap = true
                    do {
                        val event = awaitPointerEvent()
                        val zoom = event.calculateZoom()
                        val pan = event.calculatePan()

                        if (zoom != 1f || pan != Offset.Zero) isTap = false

                        if (scale > 1f || zoom > 1f) {
                            event.changes.forEach { it.consume() }
                            scale = (scale * zoom).coerceIn(1f, 5f)
                            if (scale > 1f) offset += pan else offset = Offset.Zero
                        }
                    } while (event.changes.any { it.pressed })
                    if (isTap) onTap()
                }
            },
        contentAlignment = Alignment.Center
    ) {
        val bmp = bitmap
        if (bmp == null) CircularProgressIndicator()
        else {
            Image(
                bitmap = bmp.asImageBitmap(),
                contentDescription = null,
                modifier = Modifier
                    .fillMaxSize()
                    .graphicsLayer(
                        scaleX = scale,
                        scaleY = scale,
                        translationX = offset.x,
                        translationY = offset.y
                    ),
                contentScale = ContentScale.Fit,
                colorFilter = mode.filter
            )
        }
    }
}

@Composable
fun LandscapePdfPage(
    session: PdfSession?,
    pageIndex: Int,
    mode: ReadingMode,
    highlightPositions: List<RectF>?,
    modifier: Modifier = Modifier,
    onTap: () -> Unit
) {
    val density = LocalDensity.current
    val config = LocalConfiguration.current
    val targetWidth = with(density) { config.screenWidthDp.dp.toPx() }.toInt().coerceIn(720, 1400)

    val bitmap by produceState<Bitmap?>(null, pageIndex, targetWidth, highlightPositions) {
        value = withContext(Dispatchers.IO) {
            val raw = session?.render(pageIndex, targetWidth)
            if (raw != null && !highlightPositions.isNullOrEmpty()) {
                drawHighlightsOnBitmap(raw, highlightPositions)
            } else raw
        }
    }
    val bmp = bitmap
    if (bmp != null) {
        BoxWithConstraints(
            modifier = modifier.pointerInput(Unit) { detectTapGestures(onTap = { onTap() }) }
        ) {
            val aspectRatio = bmp.width.toFloat() / bmp.height.toFloat()
            val imageHeight = maxWidth / aspectRatio
            Image(
                bitmap = bmp.asImageBitmap(),
                contentDescription = null,
                modifier = Modifier.fillMaxWidth().height(imageHeight),
                contentScale = ContentScale.FillWidth,
                colorFilter = mode.filter
            )
        }
    } else {
        Box(modifier = Modifier.fillMaxWidth().height(400.dp), contentAlignment = Alignment.Center) {
            CircularProgressIndicator()
        }
    }
}

